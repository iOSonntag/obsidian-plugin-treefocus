{
  "compilerOptions": {
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES6",
    "allowJs": true,
    "noImplicitAny": true,
    "moduleResolution": "bundler",
    "paths": {
      "src/*": ["./src/*"]
    },
    "types": ["node"],
    "esModuleInterop": true,
    "importHelpers": true,
    "strict": true,
    "isolatedModules": false,
	"strictNullChecks": true,
    "lib": [
      "DOM",
      "ES5",
      "ES6",
      "ES7",
      "ESNext"
    ]
  },
  "include": [
    "**/*.ts"
  ]
}
